{
  "name": "@trellis/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "styles:codegen": "panda codegen --spec",
    "styles:check": "panda cssgen --max-warnings=0 && eslint --config eslint.panda.config.mjs 'src/**/*.svelte' --max-warnings=0",
    "check": "pnpm styles:codegen && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm styles:check",
    "test:unit": "vp test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@sveltejs/kit": "^3.1.0",
    "@xyflow/svelte": "^1.7.0",
    "svelte": "^5.57.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pandacss/dev": "^2.4.0",
    "@pandacss/preset-base": "^2.4.0",
    "@pandacss/preset-panda": "^2.4.0",
    "@pandacss/vite": "^2.4.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "postcss": "^8.5.32",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.10.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#styled/*": "./styled-system/*/index.js"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  }
}
