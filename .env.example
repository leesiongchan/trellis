# Copy this file to .env. Keep real credentials on the server, never in chat.
OPENAI_API_KEY=
TAVILY_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Generate with: openssl rand -hex 32.
APP_ACCESS_KEY=
# Production browser origin: exact scheme, hostname and port used to access the app.
# pnpm dev explicitly uses its loopback frontend origin instead.
APP_ORIGIN=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
# Controls application verbosity; dependency events and spans stay disabled.
RUST_LOG=info
# Optional FRONTEND_DIR overrides the executable-relative public/ directory.
# APP_ENV_FILE is an optional process environment variable: blank disables .env;
# unset loads .env if present. Explicit paths must exist. Environment overrides file values.
# Required private data directory: set an absolute path outside this repository/release.
APP_DATA_DIR=
# Optional private backup directory (default: backups beside APP_DATA_DIR).
# APP_BACKUP_DIR=
# Optional verified local model assets (default: models beside the executable).
# APP_MODEL_DIR=
# Model setup is explicit: node api/scripts/fetch-embedding-model.ts .artifacts/embedding-model
# Missing/corrupt model assets disable local discovery; saved library reads still work.
# Use the same APP_ACCESS_KEY/origin on upgrade. Deploy protocol-2 frontend/backend together.
# Daily native backups retain seven completed snapshots; pre-upgrade backups are separate.
