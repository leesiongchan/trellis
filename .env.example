# Copy this file to .env. Keep real credentials on the server, never in chat.
OPENAI_API_KEY=
TAVILY_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Generate with: openssl rand -hex 32 (or: , openssl rand -hex 32 on Nix).
APP_ACCESS_KEY=
# Production browser origin. Keep the existing Tailscale scheme/hostname/port on upgrade.
# pnpm dev explicitly uses its loopback frontend origin instead.
APP_ORIGIN=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
RUST_LOG=info
# Optional FRONTEND_DIR overrides the executable-relative public/ directory.
# APP_ENV_FILE is an optional process environment variable: blank disables .env;
# unset loads .env if present. Explicit paths must exist. Environment overrides file values.
