{
  "name": "trellis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.ts",
    "build:frontend": "pnpm --dir app build",
    "build:backend": "cargo build --manifest-path api/Cargo.toml --release --locked",
    "build": "pnpm build:frontend && pnpm build:backend && node scripts/package-release.ts",
    "start": "./release/branch-backend",
    "check": "pnpm --dir app check && vp check",
    "test:unit": "pnpm --dir app test:unit",
    "test:build": "node --test tests/build/*.test.ts",
    "test:backend": "cargo test --manifest-path api/Cargo.toml --locked",
    "verify:release": "node scripts/verify-release.ts",
    "test:e2e": "pnpm --dir app test:e2e",
    "live-smoke": "node --env-file-if-exists=.env api/scripts/live-smoke.ts",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pandacss/eslint-plugin": "^2.4.0",
    "eslint": "^10.13.0",
    "vite-plus": "catalog:"
  }
}
