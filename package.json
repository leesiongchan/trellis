{
  "name": "knowledge-tree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "live-smoke": "node --env-file-if-exists=.env scripts/live-smoke.ts"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.1.0",
    "@xyflow/svelte": "1.7.0",
    "idb": "^8.0.4",
    "openai": "^7.43.0",
    "svelte": "5.57.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^26.6.5",
    "fake-indexeddb": "^6.2.6",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
