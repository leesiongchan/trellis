{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decisions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "verdict": {
            "type": "string",
            "enum": [
              "equivalent",
              "related",
              "different",
              "uncertain"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "paragraphRefs": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "answerVersionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "paragraphId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "sectionIndex": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 11
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "answerVersionId",
                "paragraphId",
                "sectionIndex"
              ]
            }
          }
        },
        "required": [
          "candidateId",
          "verdict",
          "reason",
          "paragraphRefs"
        ]
      }
    }
  },
  "required": [
    "decisions"
  ]
}
